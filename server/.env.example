# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (e.g. from Neon: Dashboard → Connect → "Pooled connection" off for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

PORT=4000
# The Next.js app's origin (for CORS and cookies).
FRONTEND_ORIGIN="http://localhost:3000"

# Long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""

# Google sign-in: OAuth client ID from Google Cloud Console (Web application).
GOOGLE_CLIENT_ID=""

# DeepSeek API (AI teacher). Get a key at https://platform.deepseek.com/api_keys
# When set, DeepSeek answers the teacher chat instead of Claude.
DEEPSEEK_API_KEY=""
# deepseek-flash (fast, cheap) or deepseek-v4-pro (stronger)
DEEPSEEK_MODEL="deepseek-flash"

# Claude API (AI teacher). Used when DEEPSEEK_API_KEY is empty. Leave both empty to disable AI answers.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"
# Max teacher answers per student per day.
CHAT_DAILY_LIMIT=60

# First admin account, created by `npm run db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
